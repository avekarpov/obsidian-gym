{
  "name": "gym",
  "version": "0.1.0",
  "private": true,
  "description": "Workout tracker for Obsidian that keeps the plan and the log in notes",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "install-vault": "node esbuild.config.mjs --install"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
